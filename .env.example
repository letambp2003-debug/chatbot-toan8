# =========================================================
# GIA SƯ AI TOÁN 8 - CẤU HÌNH MÔI TRƯỜNG
# =========================================================

# 1. Bảo mật mã hóa Session Cookie (AES-256-GCM)
# Sinh chuỗi ngẫu nhiên 32 bytes (64 hex characters) cho KEY_ENCRYPTION_SECRET
# Ví dụ: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=e7b4f8c92a1d3e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f

# 2. Supabase Configuration (PostgreSQL + pgvector + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Google AI Admin Key (Chỉ dùng server-side để Ingest & Index SGK/SBT)
# Tuyệt đối không dùng NEXT_PUBLIC_ cho key này
GEMINI_ADMIN_API_KEY=your-admin-google-ai-api-key

# 4. Model Configuration (Tùy chọn ghi đè, mặc định đã khai báo trong src/lib/ai/config.ts)
GEMINI_GENERATION_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
STRICT_TOAN8_MODE=true
